# TensorRT and CUDA Environment Configuration Template
# Copy this file to .env and modify according to your system

# ============================================================================
# TensorRT Configuration
# ============================================================================
# Path to TensorRT installation (modify according to your system)
# - For apt-installed TensorRT (Ubuntu): /usr
# - For custom TensorRT installation: /path/to/TensorRT-x.x.x
TENSORRT_ROOT=/usr

# TensorRT version (for validation and logging)
# Example: 8.5.3.1, 10.9.0.34
TENSORRT_VERSION=10.9.0.34

# ============================================================================
# CUDA Configuration
# ============================================================================
# CUDA version
# Example: 11.8, 12.6
CUDA_VERSION=12.6

# CUDA installation path (usually auto-detected)
CUDA_ROOT=/usr/local/cuda

# ============================================================================
# Docker Configuration (for building Docker images)
# ============================================================================
# Docker base image CUDA version
DOCKER_CUDA_VERSION=11.8.0

# Docker base image OS version
DOCKER_OS_VERSION=20.04

# Docker TensorRT version to install
DOCKER_TRT_VERSION=8.5.3.1

# ============================================================================
# Python Environment Configuration
# ============================================================================
# Python virtual environment path (optional, for isolation)
# Leave empty to use system Python
PYTHON_VENV_PATH=

# Python version requirement
PYTHON_VERSION=3.8

# ============================================================================
# Build Configuration
# ============================================================================
# Number of parallel jobs for compilation
BUILD_JOBS=8

# Build type: Debug or Release
BUILD_TYPE=Release

# GPU architecture (auto-detected if not set)
# Example: 75 (RTX 2080Ti), 86 (RTX 3090), 89 (RTX 4090)
GPU_ARCH=
